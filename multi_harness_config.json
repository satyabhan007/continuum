{
  "harness_pool": [
    {
      "name": "jcode",
      "models": [
        "auto"
      ],
      "token_budget": 100000,
      "default_model": "auto",
      "cost_per_1k_tokens": 0.0,
      "max_concurrent_tasks": 2,
      "api_endpoint": "local-jcode-cli",
      "priority": 1
    },
    {
      "name": "opencode",
      "models": [
        "auto"
      ],
      "token_budget": 100000,
      "default_model": "auto",
      "cost_per_1k_tokens": 0.0,
      "max_concurrent_tasks": 2,
      "api_endpoint": "local-opencode-cli",
      "priority": 2
    },
    {
      "name": "antigravity",
      "models": [
        "gemini-3-pro-preview"
      ],
      "token_budget": 100000,
      "default_model": "gemini-3-pro-preview",
      "cost_per_1k_tokens": 0.0,
      "max_concurrent_tasks": 2,
      "api_endpoint": "jcode-antigravity-provider",
      "priority": 3
    },
    {
      "name": "cline",
      "models": [
        "auto"
      ],
      "token_budget": 100000,
      "default_model": "auto",
      "cost_per_1k_tokens": 0.0,
      "max_concurrent_tasks": 1,
      "api_endpoint": "vscode-extension",
      "priority": 4
    }
  ],
  "handoff_strategy": {
    "mode": "token_based",
    "context_preservation": true,
    "auto_recovery": true,
    "token_threshold_percent": 80,
    "graceful_transfer": true,
    "handoff_priority": "token_availability",
    "enable_load_balancing": true,
    "min_harness_for_handoff": 2
  },
  "conversation_persistence": {
    "enabled": true,
    "storage": "swarm_artifacts",
    "compaction_threshold": 0.8,
    "max_history_size": 10000,
    "retention_hours": 24,
    "compression_algorithm": "gzip"
  },
  "execution_settings": {
    "max_execution_time_seconds": 300,
    "retry_attempts": 3,
    "backoff_factor": 1.5,
    "enable_streaming": true,
    "timeout_handling": "graceful",
    "resource_monitoring": true,
    "performance_tracking": true
  },
  "monitoring": {
    "token_tracking": true,
    "execution_monitoring": true,
    "harness_performance": true,
    "alerting_enabled": true,
    "metrics_retention_hours": 72
  },
  "recovery": {
    "enable_auto_recovery": true,
    "checkpoint_frequency_seconds": 30,
    "max_recovery_attempts": 5,
    "fallback_harness_selection": "intelligent",
    "preserve_error_context": true
  },
  "api_credentials": {
    "openai_api_key": "${OPENAI_API_KEY}",
    "anthropic_api_key": "${ANTHROPIC_API_KEY}",
    "google_api_key": "${GOOGLE_API_KEY}",
    "github_token": "${GITHUB_TOKEN}",
    "azure_api_key": "${AZURE_API_KEY}"
  }
}